# FUNNEL_* variables for kegeldoc (a fork of the Lane C Rank-4 funnel). Same names as funnel_app, its own file.
#
# Copy to `kegeldoc_app/.env`. Not to the repo-root `.env`: kegeldoc reads the same FUNNEL_*
# names as funnel_app, and both apps fall back to the root file, so a FUNNEL_* line there would
# configure Routine Lab and kegeldoc at once. The app's own file wins over the root's, and real
# environment variables beat both, so a container's `environment:` block always overrides this.
#
# Rule 2 of CLAUDE.md: no secret belongs in code. Every default below is chosen so that a
# missing variable means "do less", never "assume permission": charges default off, and no LLM
# key means the deterministic plan builder serves the preview instead of erroring.

# ---- Posture -------------------------------------------------------------
# Leave `false` until the funnel has been walked end to end with real funnel keys. With
# charges off, the checkout button records intent, renders the rehearsal confirmation, and
# touches no card, and the dashboard dates are labelled estimates rather than renewal dates.
# Turning this on is the single change that makes this page take money, so it is the one line
# to review twice. `true` without `STRIPE_SECRET_KEY_FUNNEL` is not a contradiction the app
# papers over: `/health` names the variable you still have to set.
FUNNEL_CHARGES_ENABLED=false

# ---- Offer, and therefore every disclosure slot --------------------------
# Minor units (cents). One source feeds the landing badge, the artefact screen, the card
# label, the refund page, the emails and the tests, so a price change cannot leave a stale
# slot behind. These three are the Phase 0 baseline: $1 for 7 days, then $39/month until
# cancelled. The renewal sentence on the checkout screen is composed from them, so an edit
# here is an edit to the disclosure.
#
# Both spellings are read, `FUNNEL_` first: the brief named `TRIAL_AMOUNT_MINOR` and friends,
# and a config that read only the prefixed form would silently keep the defaults while an
# operator believed they had changed the price.
# kegeldoc's prices are $2.99 then $24.99. They are commented out here on purpose: the test
# suite reads this app's own `.env` and pins the code defaults ($1 then $39), so a local `.env`
# copied with these lines live makes two tests fail. The VPS sets them through
# `deploy/kegeldoc_app/kegeldoc-app.env.template`. Uncomment locally to preview real prices,
# and comment them again before running the tests.
# FUNNEL_TRIAL_AMOUNT_MINOR=299
FUNNEL_TRIAL_DAYS=7
# FUNNEL_REBILL_AMOUNT_MINOR=2499
# The paywall's 4-week and 12-week plans: one charge for the whole length, then the same
# monthly rebill as the 1-week plan (which is the trial above). No two plans may share a price.
# FUNNEL_PLAN_4W_AMOUNT_MINOR=999
# FUNNEL_PLAN_12W_AMOUNT_MINOR=1999
# The paywall's limited-time discount on each plan's first charge, in basis points (3550 = 35.5%),
# and how many minutes it lasts from the visitor's first sight of the paywall. The clock is kept
# on the server: a reload never restarts it, and after it ends the full price is shown and
# charged. 0 turns it off. The monthly rebill is never discounted.
FUNNEL_INTRO_DISCOUNT_BPS=3550
FUNNEL_INTRO_DISCOUNT_MINUTES=10
FUNNEL_CURRENCY=usd
# Phase 0 spec: 14-day money-back on the trial charge. Changing this changes the promise.
FUNNEL_REFUND_WINDOW_DAYS=14

# ---- Brand and routing ---------------------------------------------------
FUNNEL_BRAND_NAME=kegeldoc
FUNNEL_PUBLIC_URL=https://kegeldoc.example
FUNNEL_HOST=127.0.0.1
FUNNEL_PORT=8091
FUNNEL_SUPPORT_EMAIL=support@kegeldoc.example

# ---- Session signing -----------------------------------------------------
# Signs the visitor cookie, which only carries quiz progress. Generate with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Left unset, the app mints a random key per process and logs a warning: progress then dies
# on restart, which is survivable but confusing to debug on a deploy. This is never the
# billing dedupe key; the processor's event id is.
FUNNEL_SESSION_SECRET=

# ---- Preview generation --------------------------------------------------
# `llm` tries the `fast` tier once and falls back to the deterministic builder on any
# problem, including a missing key. `builder` never calls a model. Structure always comes
# from the builder; the model only supplies the coach note, which is scanned for banned
# claims and dropped if it trips them.
FUNNEL_PREVIEW_MODE=llm
FUNNEL_LLM_TIMEOUT_SECONDS=25

# ---- Phase 2: save offers ------------------------------------------------
# The one-screen menu shown *after* a cancellation has already been executed. On by default
# because declining it is the customer's normal path; `false` removes the menu entirely and
# leaves the cancel button alone.
FUNNEL_SAVE_OFFER_ENABLED=true
# Option B, the lite tier. Amount only: prices are created per subscription, so no Stripe
# product has to exist for this to work.
FUNNEL_LITE_AMOUNT_MINOR=1900
# Option A, pause length in days. Shown to the customer as a date, and stated to the
# processor as the `resumes_at` timestamp behind it.
FUNNEL_PAUSE_DAYS=30
# Option C, Stripe coupon id for 50% off for two months, created in the *funnel* account. Its
# duration is set on the coupon itself ("repeat for 2 months"), not here, so this value names
# an object rather than restating a policy. Left empty, option C is withheld from the menu
# rather than offered and refused on click: an offer the processor rejects after acceptance
# sells the customer a saving their invoice does not show.
FUNNEL_DISCOUNT_COUPON_ID=

# ---- Phase 2: notices and mail -------------------------------------------
# The pre-billing notice goes out this many days before the renewal date (spec §2.1). It is a
# disclosure, not marketing, so it is sent to members who are still billing and withheld from
# anyone whose charge is already cancelled.
FUNNEL_PREBILLING_NOTICE_DAYS=2
# Days after a failed rebill before the one retry. A decline is retried once, not repeatedly:
# a card that fails twice is a churned member, not a transient network problem.
FUNNEL_DECLINE_RETRY_DAYS=3
# SMTP URL, e.g. `smtp://user:pass@mail.example:587`. Unset means write an `.eml` file to the
# outbox directory and log it, which is how the funnel runs locally and how it keeps running
# if the mail host dies: delivery failure never fails a page the customer is waiting on.
# FUNNEL_SMTP_URL=
# FUNNEL_EMAIL_FROM=Billing <billing@kegeldoc.example>
FUNNEL_EMAIL_OUTBOX=data/outbox

# ---- Phase 2: Stripe, funnel keys only -----------------------------------
# Three keys, all with the `_FUNNEL` suffix, all for the funnel's own Stripe account. The B2B
# keys are *not* read here, and the app refuses to boot a checkout that mixes lanes: an
# `sk_live` with a `pk_test`, or a key whose mode contradicts `FUNNEL_STRIPE_MODE`, raises
# rather than charging the wrong merchant account. That check is why these names are separate
# from every other Stripe variable in this repository.
# STRIPE_SECRET_KEY_FUNNEL=sk_test_
# STRIPE_PUBLISHABLE_KEY_FUNNEL=pk_test_
# Signing secret for the webhook endpoint. Unsigned events are accepted only while nothing
# automated acts on them (spec §2.4): with no secret set, `/health` says so rather than
# implying deliveries are verified. Set it before relying on a webhook-driven status change.
# STRIPE_WEBHOOK_SECRET_FUNNEL=whsec_
# `test` or `live`, and it is a *claim* about the keys above, cross-checked against their
# prefixes. Unset means whatever the key prefixes say.
# FUNNEL_STRIPE_MODE=test
# The API version pinned on every funnel request. Pinned rather than "account default" because
# an unannounced upgrade changes the shapes the funnel reads its renewal dates from.
# STRIPE_API_VERSION=2025-11-17.basil

# ---- Storage -------------------------------------------------------------
# Relative paths resolve against funnel_app/. Separate from the B2B databases on purpose:
# this is its own unit, and a funnel incident should not reach anything that bills.
#
# ON A PRODUCTION HOST, SET ALL FOUR OF THESE TO ABSOLUTE PATHS under the unit's state
# directory (/var/lib/funnel-app — see deploy/funnel_app/README.md). The repo-relative defaults
# below are correct for a laptop and wrong for a VPS, because `data/` is git-ignored: a
# `git clean -fdx` during a deploy takes the subscription table with it, WAL and all. The state
# directory is created and owned by systemd, so it needs no pre-existing directory and survives
# every redeploy:
#   FUNNEL_DB_PATH=/var/lib/funnel-app/responses.sqlite3
#   FUNNEL_BILLING_DB_PATH=/var/lib/funnel-app/billing.sqlite3
#   FUNNEL_EMAIL_OUTBOX=/var/lib/funnel-app/outbox
#   FUNNEL_METRICS_CSV=/var/lib/funnel-app/metrics/lane_c_daily.csv
FUNNEL_DB_PATH=data/responses.sqlite3
# Phase 2's own file: subscriptions, lifecycle notice markers, save-offer outcomes. Kept apart
# from quiz responses so a billing read never waits on a survey write, and so "delete the
# experiment" can keep or drop the money record deliberately.
FUNNEL_BILLING_DB_PATH=data/billing.sqlite3

# ---- Phase 3: the Day-1 metrics sheet ------------------------------------
# Where `scripts/export_lane_c_metrics.py` writes the daily row. Relative paths resolve
# against funnel_app/. Committed-to-disk rather than printed, because the sheet is read by a
# human every morning next to hand-typed cost columns, and a figure that exists only in
# whatever process printed it is a figure nobody looks at by day 34.
FUNNEL_METRICS_CSV=data/metrics/kegeldoc_daily.csv
# How far back the export's Stripe cross-check looks for *its own* recent objects when
# reconciling a day. The cumulative comparison it anchors to reaches the account's whole
# history either way, so this window only bounds the per-day money read. The default is wide
# enough to cover webhook latency plus a UTC-midnight straddle; widening it costs requests, not
# correctness. Set it on a host where the webhook is known to lag.
# FUNNEL_STRIPE_CHECK_WINDOW_HOURS=2
# A row's `notes` cell holds two things, and one character separates them: the operator's own
# text, then ` | `, then the warnings this script regenerates on every run. Type your note
# before the separator and a rerun keeps it; everything after the first ` | ` is the script's
# and is rewritten. `README.md` repeats this so the convention outlives the code.

# ---- Read by backend/llm_router.py, only when FUNNEL_PREVIEW_MODE=llm ----
# Loaded by file path rather than imported as a package, so the funnel deploys without the
# engine. No key means no call: the builder answers instead and the artefact stays real.
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=
# LLM_FAST_PROVIDER=nvidia
