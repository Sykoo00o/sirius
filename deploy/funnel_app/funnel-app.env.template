# Production EnvironmentFile for funnel-app.service.
#
# Copy to <repo>/funnel_app/.env  (chmod 600, chown the service user) and substitute the three
# marked values. This template exists because `funnel_app/.env.example` doubles as the *developer*
# reference and documents every knob; this file carries only what a production host needs set
# differently from the defaults, so the diff between rehearsal and production is one screen rather
# than 140 lines.
#
# Three substitutions, on three assignment lines: the hostname, the support address, and a fresh
# 64-char hex session secret. Verify after substituting by checking what the VALUES became, never
# by grepping for the placeholder names -- this header mentions those names, so a name-grep matches
# its own instruction and can never report "no hits" on any file, rendered or not:
#   grep -nE '^(FUNNEL_PUBLIC_URL|FUNNEL_SUPPORT_EMAIL|FUNNEL_SESSION_SECRET)=' funnel_app/.env
# Expect three lines reading https://<host>, <address>, and 64 hex chars. Anything still carrying
# an at-sign-plus-uppercase-name form (or a lone "@") on those three lines did not get substituted.
#
# The app loads this file twice over: systemd passes it as EnvironmentFile=, AND config.py's
# load_dotenv() reads funnel_app/.env itself. Process env wins (os.environ.setdefault), so the two
# cannot disagree — but it does mean the file must be valid for both readers: plain KEY=value,
# no shell expansions, no `$(...)`, since systemd does not run a shell.

# --- identity: must match the Tunnel hostname --------------------------------
# FUNNEL_PUBLIC_URL feeds canonical URLs, Stripe redirect URLs and the confirmation copy, so a
# staging deploy that forgets it advertises the production domain on its own receipts.
FUNNEL_PUBLIC_URL=https://@FUNNEL_HOSTNAME@
FUNNEL_SUPPORT_EMAIL=@SUPPORT_EMAIL@

# --- bind: loopback only, port 8090 ------------------------------------------
# The unit's ExecStart passes --host/--port explicitly, which is what actually binds. These are
# kept so that anything reading settings (the metrics script, a manual uvicorn run) agrees.
FUNNEL_HOST=127.0.0.1
FUNNEL_PORT=8090

# --- persistent state: outside the checkout ----------------------------------
# Absolute paths under the unit's StateDirectory. A repo-relative default resolves inside
# funnel_app/data/, which is git-ignored and therefore a `git clean -fdx` on the VPS can remove
# with the subscription table still in it.
FUNNEL_DB_PATH=/var/lib/funnel-app/responses.sqlite3
FUNNEL_BILLING_DB_PATH=/var/lib/funnel-app/billing.sqlite3
FUNNEL_EMAIL_OUTBOX=/var/lib/funnel-app/outbox
FUNNEL_METRICS_CSV=/var/lib/funnel-app/metrics/lane_c_daily.csv

# --- session: set this or a restart drops half-finished quizzes --------------
# Empty is tolerated (a key is generated at boot and logged), but every deploy then resets the
# quiz for anyone mid-way through it. Generate with:  openssl rand -hex 32
FUNNEL_SESSION_SECRET=@SESSION_SECRET_HEX@

# --- THE MONEY SWITCH --------------------------------------------------------
# Left false on purpose. It stays false until STRIPE_SECRET_KEY_FUNNEL,
# STRIPE_PUBLISHABLE_KEY_FUNNEL and STRIPE_WEBHOOK_SECRET_FUNNEL are all in this file, and until
# the operator has decided they want a card to move. With it false, checkout records intent, the
# outbox transport writes .eml files, and every date on the account page reads "Estimated".
FUNNEL_CHARGES_ENABLED=false

# --- keys: uncomment all four together, in one edit --------------------------
# Add the matching FUNNEL_STRIPE_MODE with the key, so a test key cannot sit beside a live key
# and fail mode validation later. With FUNNEL_STRIPE_MODE unset, a sk_test_ key means the app
# refuses to run as live rather than guessing.
# STRIPE_SECRET_KEY_FUNNEL=sk_test_
# STRIPE_PUBLISHABLE_KEY_FUNNEL=pk_test_
# STRIPE_WEBHOOK_SECRET_FUNNEL=whsec_
# FUNNEL_STRIPE_MODE=test

# A webhook secret is not optional once charges are on: without it the endpoint accepts an
# unsigned POST, which is survivable in rehearsal and forgery-accessible when live. /health names
# the missing variable rather than hiding it.

# --- mail: leave unset to rehearse, set to deliver ---------------------------
# Unset => .eml files under FUNNEL_EMAIL_OUTBOX. That is a real transport for a test week; it is
# not one when a customer is waiting for a receipt.
# FUNNEL_SMTP_URL=smtp://user:pass@mail.example.com:587
# Substituted from the same hostname value as FUNNEL_PUBLIC_URL, so a receipt's reply address can
# never name a domain the canonical links do not. Uncomment with FUNNEL_SMTP_URL, and write the
# real host in (this line stays placeholder-free so the substitution-verification grep cannot fire
# on a comment, and so uncommenting it by hand cannot ship a literal token into a Reply-To).
# FUNNEL_EMAIL_FROM=Billing <billing@your-funnel-hostname.example>

# --- intentionally NOT set here ----------------------------------------------
# SUPERVISOR_ENABLED: the funnel does not read it, and the rule is to leave it untouched. Do not
#   add it to this file; a variable that appears to configure a service that ignores it is worse
#   than one that is absent.
# ENGINE_DRY_RUN / engine.dry_run: the engine's switch, on the engine's host, unread here.
# FUNNEL_DISCOUNT_COUPON_ID: stays empty until the Stripe coupon exists. An unconfigured save
#   offer option drops off the screen instead of promising a discount the processor will not apply.
# FUNNEL_PREVIEW_MODE stays `llm`; set `local` to run the funnel with no LLM key at all.
