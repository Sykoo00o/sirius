# FUNNEL_* variables for the Lane C Rank-4 funnel (Routine Lab).
#
# Copy to `funnel_app/.env`, or to the repo-root `.env` if the funnel shares a host with the
# B2B apps. The nearest file wins and real environment variables beat both, so a container's
# `environment:` block always overrides this file.
#
# Rule 2 of CLAUDE.md: no secret belongs in code. Every default below is chosen so that a
# missing variable means "do less", never "assume permission": charges default off, and no LLM
# key means the deterministic plan builder serves the preview instead of erroring.

# ---- Phase 1 posture ------------------------------------------------------
# Leave `false` until Phase 0 sign-off. With charges off, the checkout button records
# intent, renders the rehearsal confirmation, and touches no card. Turning this on is the
# single change that makes this page take money, so it is the one line to review twice.
FUNNEL_CHARGES_ENABLED=false

# ---- Offer, and therefore every disclosure slot --------------------------
# Minor units (cents). One source feeds the landing badge, the artefact screen, the card
# label, the refund page and the tests, so a price change cannot leave a stale slot behind.
FUNNEL_TRIAL_AMOUNT_MINOR=299
FUNNEL_TRIAL_DAYS=7
FUNNEL_REBILL_AMOUNT_MINOR=2499
FUNNEL_CURRENCY=usd
# Phase 0 spec: 14-day money-back on the trial charge. Changing this changes the promise.
FUNNEL_REFUND_WINDOW_DAYS=14

# ---- Brand and routing ---------------------------------------------------
FUNNEL_BRAND_NAME=Routine Lab
FUNNEL_PUBLIC_URL=https://routinelab.example
FUNNEL_HOST=127.0.0.1
FUNNEL_PORT=8090
FUNNEL_SUPPORT_EMAIL=support@routinelab.example

# ---- Session signing -----------------------------------------------------
# Signs the visitor cookie, which only carries quiz progress. Generate with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Left unset, the app mints a random key per process and logs a warning: progress then dies
# on restart, which is survivable but confusing to debug on a deploy. This is never the
# billing dedupe key; the processor's event id is.
FUNNEL_SESSION_SECRET=

# ---- Preview generation --------------------------------------------------
# `llm` tries the `fast` tier once and falls back to the deterministic builder on any
# problem, including a missing key. `builder` never calls a model. Structure always comes
# from the builder; the model only supplies the coach note, which is scanned for banned
# claims and dropped if it trips them.
FUNNEL_PREVIEW_MODE=llm
FUNNEL_LLM_TIMEOUT_SECONDS=25

# ---- Storage -------------------------------------------------------------
# Relative paths resolve against funnel_app/. Separate from the B2B databases on purpose:
# this is its own unit, and a funnel incident should not reach anything that bills.
FUNNEL_DB_PATH=data/responses.sqlite3

# ---- Read by backend/llm_router.py, only when FUNNEL_PREVIEW_MODE=llm ----
# Loaded by file path rather than imported as a package, so the funnel deploys without the
# engine. No key means no call: the builder answers instead and the artefact stays real.
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=
# LLM_FAST_PROVIDER=nvidia
