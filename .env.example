# ============================================================================
# Ghost X2 - multi-agent grey-hat business engine
#
# From the old "ops" project we KEPT: Supabase DB, LLM keys, Jina/Exa, the
# read-only Stripe key, tz. We DROPPED: UnitTrail, Ivy/Gmail, NVIDIA, Apollo/
# Instantly, Agent Reach research knobs, landing-page keys, Companies House.
# Those settings belonged to other products, not this engine.
#
# Secrets are live and are never printed in logs or agent stdout. They belong
# in a password manager for anything beyond local dev.
# ============================================================================

# ==================== Runtime ====================
# container | local. "container" (what docker-compose sets) refuses local sudo.
ENGINE_RUNTIME=local
ENGINE_ENV=dev
# Timezone for digests, day-boundaries and ledger timestamps.
OWNER_TIMEZONE=Africa/Lagos

# ==================== LLM (OpenRouter) ====================
OPENROUTER_API_KEY=
LLM_MODEL_CHEAP=anthropic/claude-haiku-5.5
LLM_MODEL_STRONG=anthropic/claude-sonnet-5.5
# Kill switch on LLM spend per day, USD. Blows up well before the card does.
LLM_DAILY_CAP_USD=8
# Seconds a single LLM call may take before it is abandoned and retried.
LLM_TIMEOUT_SECONDS=90
LLM_MAX_ATTEMPTS=3
# Fallback ladder when the router is throttled or down.
LLM_FALLBACK_CHAIN=anthropic/claude-haiku-5.5,openai/gpt-5-mini

# ==================== LLM router (backend/llm_router.py) ====================
# Second provider, OpenAI-compatible. Optional: with only OPENROUTER_API_KEY set the
# router runs on OpenRouter alone, and both tiers resolve there. NIM is worth setting
# because its free-tier keys should absorb the fast tier (every Telegram message) and
# leave OpenRouter carrying the reasoning calls it is actually billed for.
NVIDIA_API_KEY=
# Optional endpoint overrides (dedicated NIM deployment, or an OpenRouter proxy).
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Which provider a tier prefers when both are configured. Reasoning defaults to
# openrouter (the only one of the two that serves Claude), fast to nvidia.
# LLM_FAST_PROVIDER=nvidia
# LLM_REASONING_PROVIDER=openrouter
# Or force one order for every tier: LLM_PROVIDER_ORDER=nvidia,openrouter

# Model chains are per PROVIDER and per TIER, because the two catalogues sell
# different slugs (NVIDIA has no Anthropic entries at all). These append to the
# built-in defaults; LLM_ROUTER_<PROVIDER>_MODELS outranks the tier-wide line.
# LLM_ROUTER_FAST_MODELS=
# LLM_ROUTER_REASONING_MODELS=
# LLM_ROUTER_NVIDIA_MODELS=meta/llama-3.3-70b-instruct
# LLM_ROUTER_OPENROUTER_MODELS=anthropic/claude-3.5-sonnet
# Substring allowlist applied to OpenRouter only (a marketplace that takes almost
# any name), for deployments that want one fixed surface.
# LLM_ROUTER_ALLOWED_MODELS=

# ==================== Telegram conversational agent ====================
# Plain-English chat through the router, with read-only tools. Commands (/status,
# /pending, /approve, /reject) and the card buttons never consult a model, so this
# switch cannot disable an approval path. Off only for a provider outage.
TG_LLM_ENABLED=true

# ==================== Database (Supabase Postgres) ====================
# Session pooler (IPv4). The direct connection is IPv6-only and fails here.
DATABASE_URL=
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_STATEMENT_TIMEOUT_MS=15000
# Supabase Project Settings > API Keys > publishable/anon key (safe in a browser).
SUPABASE_ANON_KEY=
SUPABASE_URL=https://onhqemiklubbycyjswcc.supabase.co

# ==================== HTTP API ====================
BACKEND_PORT=3100
PUBLIC_BASE_URL=http://localhost:3100

# ==================== Supervisor loop ====================
SUPERVISOR_TICK_SECONDS=20
WORKER_TICK_SECONDS=60
# A worker with no heartbeat newer than this is declared dead by the supervisor.
HEARTBEAT_STALE_SECONDS=180
# Approval gates from architecture doc section 3. Minor units (cents).
APPROVAL_TIER1_MAX_MINOR=5000
APPROVAL_TIER2_MAX_MINOR=25000
# Pending approvals older than this expire and auto-reject.
APPROVAL_EXPIRY_HOURS=24

# ==================== Telegram (control interface A) ====================
TELEGRAM_MODE=polling
TELEGRAM_OWNER_ID=1489331008
# webhook mode only: long random string + the public HTTPS URL of this server.
TELEGRAM_WEBHOOK_SECRET=
# Leave TELEGRAM_BOT_TOKEN empty until you create this engine's own bot.
TELEGRAM_APPROVAL_BOT_TOKEN=
TELEGRAM_APPROVAL_CHAT_ID=__REPLACE_WITH_APPROVAL_CHANNEL_CHAT_ID__
DIGEST_CRON=0 8 * * *

# ==================== Webhooks ====================
# 32+ random bytes, shared with the Cloudflare Worker. Empty = HMAC unsigned.
WEBHOOK_SIGNING_SECRET=__REPLACE_WITH_32_RANDOM_BYTES__
# Stripe signing secret for the funnel merchant account (whsec_...). This one is read by
# `funnel_app`, which verifies the signature on `/webhooks/stripe` before acting on a status
# change. The rest of this file's funnel keys belong to the engine's finance reads below and
# are not interchangeable with the three writing keys further down.
STRIPE_WEBHOOK_SECRET_FUNNEL=

# ==================== Financial rails ====================
# Default currency for minors (cents). ISO 4217.
DEFAULT_CURRENCY=USD
# Kill switch for ALL external side effects. Read live from settings, not here:
# change the DB row to arm/disarm without a redeploy. This seeds it once.
ENGINE_DRY_RUN=true
# True lets local sudo bypass the container-runtime check. Keep false.
ALLOW_LOCAL_SUDO=false

# ==================== Stripe restricted keys (finance reads) ====================
# Read-only rk_live_ keys, one per merchant account (section 3 merchant isolation).
# The old single key is kept as the funnel account's reader; B2B gets its own.
STRIPE_READ_KEY_FUNNEL=
STRIPE_READ_KEY_B2B=

# ---- Lane C funnel checkout (writes) ------------------------------------
# The three keys `funnel_app` charges cards with, for the funnel's own merchant account.
# Never the B2B keys, and never these in the B2B apps: the funnel reads only the `_FUNNEL`
# spellings and raises if a key's prefix contradicts `FUNNEL_STRIPE_MODE`, so a lane mix is a
# boot failure rather than a charge on the wrong account. Full documentation of the
# `FUNNEL_*` offer, mail and save-offer variables lives in `funnel_app/.env.example`.
STRIPE_SECRET_KEY_FUNNEL=
STRIPE_PUBLISHABLE_KEY_FUNNEL=
# FUNNEL_STRIPE_MODE=test
# Card issuer for per-worker virtual cards (Module 2). Empty until provisioned.
CARD_ISSUER_PROVIDER=stripe_issuing
CARD_ISSUER_API_KEY=
# Hard per-card caps in minor units.
CARD_DAILY_CAP_MINOR=5000
CARD_MONTHLY_CAP_MINOR=50000

# ==================== Research sources (marketing/hustle sourcing) ====================
JINA_AI_API_KEY=
EXA_API_KEY=

